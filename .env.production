# Values baked into the published package (vite build runs in production
# mode, so these override .env and .env.local). Both are public.
# scripts/check-publish-flags.mjs fails the publish if either is missing.

# Logged-out visitors can ask questions, protected by Turnstile.
VITE_ALLOW_ANON_ACCESS=true

# Cloudflare Turnstile site key for the ACCESS chatbot widget (managed mode).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACyJamk8FS7-RSMr
